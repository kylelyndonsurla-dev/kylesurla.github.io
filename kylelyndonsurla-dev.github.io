<div class="lightbox" id="lightbox" aria-hidden="true"><div class="lightbox-backdrop" data-close-lightbox></div><div class="lightbox-shell" role="dialog" aria-modal="true" aria-label="Image viewer"><div class="lightbox-toolbar"><span id="zoomLabel">100%</span><div><button type="button" data-zoom-out aria-label="Zoom out">−</button><button type="button" data-zoom-reset>Reset</button><button type="button" data-zoom-in aria-label="Zoom in">+</button><button type="button" data-close-lightbox aria-label="Close image">×</button></div></div><div class="lightbox-stage"><img id="lightboxImage" alt="Expanded portfolio image"></div><p id="lightboxCaption"></p></div></div>
